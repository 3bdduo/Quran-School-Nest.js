# رابط قاعدة بيانات MongoDB
MONGODB_URI=mongodb://localhost:27017/quran_school

# سر توقيع الـ JWT — غيّره في الإنتاج لقيمة عشوائية طويلة
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=24h

# باسورد الأدمن الافتراضي أول ما تتعمل الداتابيز (Seed)
ADMIN_DEFAULT_PASSWORD=Admin123

# البورت
PORT=3000

# الروابط المسموح لها تتكلم مع الـ API (CORS) — افصل بينهم بفاصلة
CORS_ORIGINS=https://3bdduo-bit.github.io,http://localhost:3000
